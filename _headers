/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://cdn.sheetjs.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co https://generativelanguage.googleapis.com https://api.anthropic.com https://api.openai.com https://cdn.jsdelivr.net https://tessdata.projectnaptha.com; img-src 'self' data: blob:; worker-src 'self' blob: https://cdn.jsdelivr.net; frame-ancestors 'none'

# Cloudflare Pages JOINS the values when several rules match one URL, so the
# rules below must not overlap. (The old "/*.js" immutable rule also matched
# /sw.js and produced a contradictory "no-store, ... max-age=31536000".)
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# Icons keep the same filenames, so don't mark them immutable for a year.
/icon-*.png
  Cache-Control: public, max-age=86400

/push-config.json
  Cache-Control: no-cache
